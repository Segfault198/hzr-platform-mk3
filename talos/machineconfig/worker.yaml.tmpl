# PATCH REFERENCE only. Prefer: talosctl gen config (docs/lab.md).
# Use the same worker.yaml for hzr-w-1 and hzr-w-2.

machine:
  type: worker
  install:
    disk: /dev/sda
    image: LAB_INSTALLER_IMAGE
  network:
    hostname: LAB_WORKER_HOSTNAME
    interfaces:
      - interface: eth0
        dhcp: true
  kubelet:
    extraMounts:
      - destination: /var/lib/longhorn
        type: bind
        source: /var/lib/longhorn
        options:
          - bind
          - rshared
          - rw

cluster:
  controlPlane:
    endpoint: https://LAB_VIP:6443
